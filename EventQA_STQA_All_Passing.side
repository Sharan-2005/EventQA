{
  "id": "eventqa-stqa-all-passing",
  "version": "2.0",
  "name": "EventQA STQA Automation - Passing Test Suite",
  "url": "https://event-qa-bay.vercel.app",
  "tests": [
    {
      "id": "pass01-home",
      "name": "PASS01 - Home Page Loads",
      "commands": [
        {
          "id": "1",
          "command": "open",
          "target": "/",
          "value": ""
        },
        {
          "id": "2",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"EventQA\")]",
          "value": ""
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"Seamless Online Event Registration\")]",
          "value": ""
        }
      ]
    },
    {
      "id": "pass02-events",
      "name": "PASS02 - Events Page Loads",
      "commands": [
        {
          "id": "1",
          "command": "open",
          "target": "/events",
          "value": ""
        },
        {
          "id": "2",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"Tech Innovation Summit 2026\")]",
          "value": ""
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"Web Development Workshop\")]",
          "value": ""
        },
        {
          "id": "4",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"AI & Machine Learning Seminar\")]",
          "value": ""
        }
      ]
    },
    {
      "id": "pass03-search",
      "name": "PASS03 - Event Search",
      "commands": [
        {
          "id": "1",
          "command": "open",
          "target": "/events",
          "value": ""
        },
        {
          "id": "2",
          "command": "type",
          "target": "css=[data-testid=\"event-search\"]",
          "value": "AI"
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"AI & Machine Learning Seminar\")]",
          "value": ""
        }
      ]
    },
    {
      "id": "pass04-filter",
      "name": "PASS04 - Category Filter",
