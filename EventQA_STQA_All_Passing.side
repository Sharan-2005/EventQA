        {
          "id": "1",
          "command": "open",
          "target": "/events",
          "value": ""
        },
        {
          "id": "2",
          "command": "select",
          "target": "css=[data-testid=\"event-filter\"]",
          "value": "label=Workshop"
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),\"Web Development Workshop\")]",
          "value": ""
        }
      ]
    },
